{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ESP32 QEMU (attach)",
      "type": "gdb",
      "request": "attach",
      "executable": "${workspaceFolder}/build/tests.elf",
      "target": "127.0.0.1:3333",
      "remote": true,
      "cwd": "${workspaceFolder}",
      // "gdbpath": "/home/q/.espressif/tools/tools/xtensa-esp-elf-gdb/17.1_20260402/xtensa-esp-elf-gdb/bin/xtensa-esp-elf-gdb-3.14",
      "gdbpath": "${workspaceFolder}/bin/esp-gdb-idf.sh",
      "debugger_args": [
        "-x=${workspaceFolder}/build/gdbinit/symbols",
        "-x=${workspaceFolder}/build/gdbinit/prefix_map",
        "-x=${workspaceFolder}/build/gdbinit/py_extensions"
      ],
      "valuesFormatting": "parseText",
      "printCalls": true,
      "showDevDebugOutput": true,
      "autorun": [
        "monitor reset halt",
        "maintenance flush register-cache",
        "thbreak app_main",
        "continue"
      ]
    }
  ]
}
